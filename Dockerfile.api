# syntax=docker/dockerfile:1
# tribu-api : aucune dépendance à installer — node:http et node:sqlite suffisent.
FROM node:24-alpine
WORKDIR /app
COPY server ./server
ENV NODE_ENV=production PORT=8080 DB_PATH=/data/tribu.sqlite
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -qO- http://127.0.0.1:8080/api/health >/dev/null || exit 1
CMD ["node", "server/index.mjs"]
