{
  "name": "tribu",
  "version": "3.72.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsrs --noEmit && vite build",
    "test": "node --import ./tests/resolve-ts.mjs --test --test-concurrency=2 'tests/*.test.mjs'",
    "preview": "vite preview --host",
    "check:console": "node tools/console-check.mjs",
    "perf:budget": "node tools/perf-budget.mjs",
    "typecheck": "tsrs --noEmit",
    "lint": "OXLINT_TSGOLINT_PATH=\"$(tsrslint-path)\" oxlint --type-aware"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@maschwenk/tsrslint": "0.1.5",
    "@types/three": "^0.185.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
